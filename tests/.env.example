# 测试环境配置文件
# 复制此文件为 .env 并修改配置

# 后端服务地址
TEST_BASE_URL=http://localhost:8000/api

# ==================== 模块开关 ====================
# 设置为 true 启用对应模块测试，false 禁用
TEST_MODULE_SYSTEM_MANAGEMENT=true
TEST_MODULE_AUTOFILL=false
TEST_MODULE_RULE_MANAGEMENT=false

# ==================== 超级管理员 ====================
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=123456

# ==================== 测试租户 ====================
TEST_TENANT_NAME=测试公司A
TEST_TENANT_DOMAIN=test-company-a.com
TEST_TENANT_DESC=测试租户A

# ==================== 租户管理员 ====================
TEST_TENANT_ADMIN_USERNAME=testadmin
TEST_TENANT_ADMIN_EMAIL=testadmin@test-company-a.com
TEST_TENANT_ADMIN_PASSWORD=123456
TEST_TENANT_ADMIN_ALIAS=测试管理员

# ==================== 测试普通用户 ====================
TEST_USER_USERNAME=testuser1
TEST_USER_EMAIL=testuser1@test-company-a.com
TEST_USER_PASSWORD=123456
TEST_USER_ALIAS=测试用户1

# ==================== 测试角色 ====================
TEST_ROLE_NAME=普通用户
TEST_ROLE_DESC=租户内普通用户角色
