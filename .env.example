# =============================================================================
# Docker Compose 环境变量配置文件
# 复制此文件为 .env 并根据需要修改配置
# cp .env.example .env
# =============================================================================

# =============================================================================
# PostgreSQL 配置 (用于 LiteLLM)
# =============================================================================
POSTGRES_IMAGE=postgres:15-alpine
POSTGRES_CONTAINER_NAME=autofill-postgres
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm123456
POSTGRES_DB=litellm
POSTGRES_PORT=5432
# 数据存储路径：使用命名卷或本地路径
POSTGRES_DATA_PATH=postgres_data
# POSTGRES_DATA_PATH=./data/postgres
# 初始化脚本路径（可选）
# POSTGRES_INIT_PATH=./init/postgres

# =============================================================================
# SeekDB 配置 (AI 向量数据库)
# =============================================================================
SEEKDB_IMAGE=oceanbase/seekdb:latest
SEEKDB_CONTAINER_NAME=autofill-seekdb
SEEKDB_PORT=2882
# root 用户密码
SEEKDB_ROOT_PASSWORD=seekdb123456
# 资源配置
SEEKDB_CPU_COUNT=4
SEEKDB_MEMORY_LIMIT=2G
SEEKDB_LOG_DISK_SIZE=2G
SEEKDB_DATAFILE_SIZE=2G
SEEKDB_DATAFILE_NEXT=2G
SEEKDB_DATAFILE_MAXSIZE=50G
# 数据存储路径：使用命名卷或本地路径
SEEKDB_DATA_PATH=seekdb_data
# SEEKDB_DATA_PATH=./data/seekdb
# 配置文件路径（可选）
# SEEKDB_CONFIG_PATH=./init/seekdb
# 初始化脚本路径（可选）
# SEEKDB_INIT_PATH=./init/seekdb/init.d

# =============================================================================
# 主应用配置
# =============================================================================
APP_CONTAINER_NAME=autofill-app
APP_PORT=9998
APP_DEBUG=false
APP_BASE_URL=http://localhost:9998
# 安全密钥（生产环境请修改）
APP_SECRET_KEY=3488a63e1765035d386f05409663f55c83bfae3b3c61a932744b20ad14244dcf
APP_JWT_EXPIRE_MINUTES=10080

# =============================================================================
# MySQL 数据库配置 (主业务数据库)
# =============================================================================
# host.docker.internal 表示宿主机（开发环境）
# 如果是生产环境，改为实际的 MySQL 服务器地址
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DATABASE=autofill

# =============================================================================
# SeekDB 客户端配置
# =============================================================================
SEEKDB_ENABLED=true
SEEKDB_MODE=remote
SEEKDB_HOST=seekdb
SEEKDB_PORT=2881
SEEKDB_USER=root
# 注意：SEEKDB_PASSWORD 默认使用 SEEKDB_ROOT_PASSWORD
SEEKDB_DATABASE=autofill

# =============================================================================
# Redis 配置
# =============================================================================
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=redis123456
REDIS_DB=3
REDIS_KEY_PREFIX=auto_fill

# =============================================================================
# LiteLLM 配置
# =============================================================================
LITELLM_CONTAINER_NAME=autofill-litellm
LITELLM_PORT=4001
LITELLM_HOST=litellm
LITELLM_MASTER_KEY=sk-litellm-master-key
LITELLM_LOG_LEVEL=INFO
LITELLM_CONFIG_PATH=./litellm/config.yaml
# 可选：模型配置文件目录
# LITELLM_MODELS_PATH=./litellm/models

# =============================================================================
# Kafka 配置
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092

# =============================================================================
# 日志配置
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# =============================================================================
# 上传文件配置
# =============================================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5

# =============================================================================
# 宿主机路径映射（用于数据持久化）
# =============================================================================
# 上传文件存储路径
UPLOADS_HOST_PATH=./uploads
# 日志存储路径
LOGS_HOST_PATH=./logs
# 配置文件路径
CONFIG_HOST_PATH=./config.docker.toml
# 额外数据目录
DATA_HOST_PATH=./data
