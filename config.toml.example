# 数据库配置
[database.mysql]
host = "127.0.0.1"
port = 3306
user = "root"
password = "root123456"
database = "autofill"

# seekdb 配置
[seekdb]
enabled = true
mode = "embedded"  # embedded 或 remote
# 嵌入式模式配置（mode = "embedded" 时使用）
db_path = "./data/seekdb.db"
default_database = "autofill"
# 远程模式配置（mode = "remote" 时使用）
host = "127.0.0.1"
port = 2881
user = "root"
password = ""
database = "autofill"

# Redis 配置
[redis]
host = "127.0.0.1"
port = 6379
password = ""
db = 0
key_prefix = "autofill"

# Dify AI 服务配置
[dify]
dify_timeout = 60.0

# Kafka 配置
[kafka]
# Kafka 连接配置
bootstrap_servers = "localhost:9092"
client_id = "autofill-python-client"

# 生产者配置
[kafka.producer]
acks = "all"              # 等待所有副本确认
retries = 3               # 发送失败重试次数
batch_size = 16384        # 批量发送大小
linger_ms = 10            # 延迟发送时间

# 消费者配置
[kafka.consumer]
group_id = "autofill-consumer-group"
auto_offset_reset = "earliest"   # 从最早消息开始消费
enable_auto_commit = true        # 自动提交偏移量
auto_commit_interval_ms = 5000   # 自动提交间隔

# 主题配置
[kafka.topic]
name = "autofill.ai.requests"
partitions = 3
replication_factor = 1

# 应用配置
[app]
debug = true
secret_key = "your-secret-key-here"
jwt_access_token_expire_minutes = 10080

[app.cors]
origins = ["*"]
allow_credentials = true
allow_methods = ["*"]
allow_headers = ["*"]

# 上传配置
[upload]
upload_dir = "./uploads"
avatar_dir = "./uploads/avatars"
allowed_extensions = [".jpg", ".jpeg", ".png", ".gif", ".webp"]
max_file_size = 5
file_url_prefix = "/uploads"

# 日志配置
[logging]
level = "INFO"
log_file = "./logs/app.log"
max_bytes = 10
backup_count = 5
console_output = true
file_output = true
format = "json"
enable_request_id = true
# 日志参数长度限制配置（防止日志过大）
# 单个字段值最大长度（字符数），超过则截断
max_field_length = 2000
# 请求/响应体最大长度（字符数），超过则截断
max_body_length = 50000  # 50KB
# 响应体大小限制（用于判断是否记录响应内容）
response_size_limit = 100000  # 100KB
# 系统日志跳过路径（这些路径不记录系统日志）
skip_paths = ["/docs", "/openapi.json", "/redoc", "/health", "/uploads/"]
# 敏感字段列表（日志中会被替换为***）
sensitive_fields = [
  "password",
  "token",
  "secret",
  "key",
  "auth",
  "authorization",
  "cookie"
]

# 租户上下文中间件配置
[tenant_middleware]
# 租户上下文中间件排除路径（这些路径跳过租户认证）
exclude_paths = [
  "/docs",
  "/openapi.json",
  "/redoc",
  "/health",
  "/uploads/",
  "/api/autofill/llm/rule/execute",
  "/api/autofill/llm/rule/execute/result"
]

# 审计日志中间件配置
[audit_log_middleware]
# 审计日志特殊路径（用于特殊处理）
special_paths = ["/api/v1/auditlog/list"]

# LiteLLM 网关配置
[litellm]
# LiteLLM 网关地址
base_url = "http://localhost:4000"
# LiteLLM 网关 API Key（用于管理接口）
master_key = "sk-litellm-master-key"
# 默认超时时间（秒）
timeout = 60

# 结构化输出配置
[structured_output]
# 方法失败阈值，达到此值后自动标记为不支持
failed_threshold = 2
# 是否自动更新模型能力状态
auto_update_capabilities = true
# 默认方法优先级（可被请求参数覆盖）
default_method_priority = [
  "with_structured_output",
  "bind_tools_stream",
  "custom_fc_non_stream",
  "custom_fc_stream",
  "pydantic_parser",
  "json_parser"
]
# 是否启用方法降级
enable_fallback = true
# 最大尝试方法数（防止无限循环）
max_attempt_methods = 6

# API权限管理配置
[api_management]
# API权限管理配置 - 排除的tags（这些tags的API不会被纳入权限管理）
# 默认排除公开API、文件上传等不需要权限控制的接口
exclude_tags = ["公开接口", "文件上传", "public", "upload"]

# 审计日志配置
[audit_log]
# 审计日志配置 - 排除的API路径（这些路径不记录审计日志的入参和出参）
# 用于排除导出、导入等大内容接口
exclude_paths = ["/api/v1/autofill/rule/export", "/api/v1/autofill/rule/import"]
